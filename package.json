{
  "name": "deskmate",
  "version": "0.2.9",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "Headless core for the shared org agent (managed-agents architecture).",
  "engines": {
    "node": ">=24.15.0",
    "npm": ">=11.10.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/index.ts",
    "dev": "SHUTDOWN_DRAIN_MS=2000 node --env-file-if-exists=.env --watch src/index.ts",
    "test": "node --experimental-test-module-mocks --test test/*.test.ts",
    "test:root:shard": "node scripts/run-root-test-shard.mjs",
    "test:root:shard:check": "node scripts/run-root-test-shard.mjs --check --shards 5",
    "test:e2e": "node --test test/e2e/*.test.ts",
    "test:all": "node --experimental-test-module-mocks --test 'test/**/*.test.ts'",
    "deploy:fly-image": "flyctl deploy --remote-only --build-only --push --image-label latest --app \"${FLY_SANDBOX_APP_NAME:?Set FLY_SANDBOX_APP_NAME to your operator-owned app}\" -c fly/fly.toml --dockerfile fly/Dockerfile . --yes",
    "test:pg": "node --test --test-concurrency=1 test/postgres-replay-dedupe.test.ts",
    "check:version": "node scripts/check-version-coherence.mjs",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "lint": "eslint .",
    "lint:ox": "oxlint --deny-warnings src plugins scripts cli test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.149",
    "@anthropic-ai/tokenizer": "^0.0.4",
    "@aws-sdk/client-s3": "^3.1052.0",
    "@aws-sdk/client-secrets-manager": "^3.1052.0",
    "@aws-sdk/client-sts": "^3.1052.0",
    "@fly/sprites": "0.0.1",
    "@openai/codex": "0.133.0",
    "@opencode-ai/plugin": "1.15.7",
    "@opencode-ai/sdk": "1.15.7",
    "@slack/bolt": "^4.7.2",
    "@slack/socket-mode": "^2.0.7",
    "@slack/web-api": "^7.16.0",
    "croner": "^10.0.1",
    "emoji-datasource": "^16.0.0",
    "fastify": "^5.8.5",
    "jose": "^6.2.3",
    "lru-cache": "^11.5.0",
    "opencode-ai": "1.15.7",
    "pg": "^8.13.1",
    "pg-boss": "^12.18.2",
    "tar-stream": "^3.2.0",
    "zod": "4.4.3"
  },
  "overrides": {
    "@hono/node-server": "2.0.3",
    "@fastify/ajv-compiler": {
      "fast-uri": "3.1.2"
    },
    "ajv": {
      "fast-uri": "3.1.2"
    },
    "brace-expansion": "5.0.6",
    "fast-json-stringify": {
      "fast-uri": "3.1.2"
    },
    "protobufjs": "7.6.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "@types/tar-stream": "^3.1.4",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "knip": "^6.14.2",
    "oxlint": "^1.66.0",
    "prettier": "3.8.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.59.4"
  }
}
